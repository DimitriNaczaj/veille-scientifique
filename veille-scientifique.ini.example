[imap]
host = mail.infomaniak.com
port = 993
username = science-digest@example.org
password_env = SCIENCE_DIGEST_MAIL_PASSWORD
folder = Articles
# Premier lancement quotidien : ignorer l’historique déjà présent.
initial_mode = latest

[smtp]
host = mail.infomaniak.com
port = 587
security = starttls
# username et password/password_env sont repris de [imap] s’ils sont omis.
# Si le compte SMTP est distinct, décommenter et adapter les deux lignes suivantes :
# username = smtp-science-digest@example.org
# password_env = SCIENCE_DIGEST_SMTP_PASSWORD
from_address = science-digest@example.org
test_recipient = science-digest@example.org

[digest]
recipient = consultant@example.org
from_address = science-digest@example.org
subject_prefix = Veille scientifique Bellegarde

[feedback]
# Chaque bouton prépare un courriel vers la boîte scientifique. Seuls les
# messages envoyés par le destinataire du digest sont acceptés.
enabled = true
recipient = science-digest@example.org
authorized_sender = consultant@example.org
folder = INBOX
inbox = /volume1/Bellegarde/veille-scientifique/feedback-inbox
output = /volume1/Bellegarde/veille-scientifique/out/feedback.csv
token_secret_env = SCIENCE_DIGEST_FEEDBACK_SECRET
sync_limit = 50

[app]
inbox = /volume1/Bellegarde/veille-scientifique/inbox
database = /volume1/Bellegarde/veille-scientifique/data/veille.sqlite
output = /volume1/Bellegarde/veille-scientifique/out/digest.html
crossref_email = science-digest@example.org
sync_limit = 200
enrichment_limit = 100
ai_limit = 30

[ai]
enabled = true
model = gpt-5.6-luna
api_key_env = OPENAI_API_KEY

[elsevier]
# La valeur reste dans secrets.env ; seule cette variable est nommée ici.
api_key_env = ELSEVIER_API_KEY

# Catalogues ouverts interrogés par DOI quand Crossref ne fournit pas de résumé.
# Ni clé ni abonnement ; l’adresse de contact reprise de app.crossref_email
# donne accès au « polite pool » d’OpenAlex.
[openalex]
enabled = true

[europepmc]
enabled = true

[backfill]
# La préparation et l’enrichissement sans IA restent possibles quand enabled = false.
# Ne passer à true qu’après contrôle du plan et choix du budget total de campagne.
enabled = false
plan = /volume1/Bellegarde/veille-scientifique/out/rattrapage-plan.json
output = /volume1/Bellegarde/veille-scientifique/out/rattrapage.html
classification = /volume1/Bellegarde/veille-scientifique/out/rattrapage-classement.csv
sample = /volume1/Bellegarde/veille-scientifique/out/rattrapage-sample.csv
sample_size = 100
profile = standard
enrichment_limit = 100
article_limit = 15
# 0 classe tout le reste en un seul lancement, avec reprise après interruption.
classification_batch_limit = 0
# Nombre maximal d’articles pertinents envoyés chaque jour après le classement.
daily_articles = 10
budget_usd = 0
